{% extends 'base.html.twig' %}

{% block title %}Sociétés - CloudBill{% endblock %}
{% block page_title %}Gestion des Sociétés{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <form method="get" class="d-flex w-50">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" name="q" value="{{ search_query }}" class="form-control border-start-0 ps-0" placeholder="Rechercher une société (nom, email)...">
            <button type="submit" class="btn btn-outline-secondary">Chercher</button>
        </div>
    </form>
    
    <a href="{{ path('app_company_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouvelle Société
    </a>
</div>

<div class="glass-card overflow-hidden">
    <table class="table table-dark table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Contact</th>
                <th>Projets (SO)</th>
                <th>Date d'ajout</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for company in pagination %}
            <tr>
                <td class="fw-semibold">{{ company.name }}</td>
                <td>
                    {% if company.email %}<div class="small"><i class="fas fa-envelope text-muted me-1"></i> {{ company.email }}</div>{% endif %}
                    {% if company.phone %}<div class="small"><i class="fas fa-phone text-muted me-1"></i> {{ company.phone }}</div>{% endif %}
                    {% if not company.email and not company.phone %}<span class="text-muted fst-italic small">Non renseigné</span>{% endif %}
                </td>
                <td>
                    <span class="badge bg-secondary">{{ company.projects|length }} projet(s)</span>
                </td>
                <td>{{ company.createdAt ? company.createdAt|date('d/m/Y') : '' }}</td>
                <td class="text-end">
                    <a href="{{ path('app_company_show', {'id': company.id}) }}" class="btn btn-sm btn-outline-light border-0" title="Détails">
                        <i class="fas fa-eye text-info"></i>
                    </a>
                    <a href="{{ path('app_company_edit', {'id': company.id}) }}" class="btn btn-sm btn-outline-light border-0" title="Modifier">
                        <i class="fas fa-edit text-warning"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">
                    <i class="fas fa-box-open fs-3 mb-3 d-block"></i>
                    Aucune société trouvée.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
