<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Cloud Billing{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    {% block stylesheets %}{% endblock %}
    
    {{ importmap('app') }}
</head>
<body>
    {% if app.user %}
        <div class="ns-watermark-bg"></div>
        <div id="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar">
                <a href="{{ path('app_dashboard') }}" class="sidebar-brand text-decoration-none">
                    <img src="{{ asset('images/ns-logo.png') }}" alt="NS Logo" class="ns-logo">
                    <div class="sidebar-brand-text">
                        <span class="app-name">CloudBill</span>
                        <span class="app-sub">Facturation Cloud</span>
                    </div>
                </a>
                
                <ul class="nav flex-column mb-auto mt-2">
                    <li class="sidebar-section-title">Gestion</li>
                    <li class="nav-item">
                        <a href="{{ path('app_company_index') }}" class="nav-link sidebar-pop {% if app.request.attributes.get('_route') starts with 'app_company' %}active{% endif %}">
                            <i class="fas fa-building"></i> Sociétés
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_project_index') }}" class="nav-link sidebar-pop {% if app.request.attributes.get('_route') starts with 'app_project' %}active{% endif %}">
                            <i class="fas fa-diagram-project"></i> Projets (SO)
                        </a>
                    </li>

                    <li class="sidebar-section-title">Facturation</li>
                    <li class="nav-item">
                        <a href="{{ path('app_invoice_history') }}" class="nav-link sidebar-pop {% if app.request.attributes.get('_route') starts with 'app_invoice' %}active{% endif %}">
                            <i class="fas fa-file-invoice-dollar"></i> Factures
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_consolidated_index') }}" class="nav-link sidebar-pop {% if app.request.attributes.get('_route') starts with 'app_consolidated' %}active{% endif %}">
                            <i class="fas fa-layer-group"></i> Facture Consolidée
                        </a>
                    </li>

                    <li class="sidebar-section-title">Collaboration</li>
                    <li class="nav-item">
                        <a href="{{ path('app_todo') }}" class="nav-link sidebar-pop {% if app.request.attributes.get('_route') starts with 'app_todo' %}active{% endif %}" style="color:#f59e0b;">
                            <i class="fas fa-list-check"></i> To-Do Board
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_consultant_chat_index') }}" class="nav-link sidebar-pop d-flex align-items-center justify-content-between {% if app.request.attributes.get('_route') starts with 'app_consultant_chat' %}active{% endif %}" style="color:#0ea5e9;">
                            <span><i class="fas fa-comments me-2"></i> Chat Room</span>
                            <span id="consultantChatBadge" class="badge rounded-pill bg-danger" style="font-size:0.65rem; display:none;">0</span>
                        </a>
                    </li>



                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="sidebar-section-title">Administration</li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_dashboard') }}" class="nav-link" style="color: var(--ns-cyan); font-weight: 600; background: rgba(14, 165, 233, 0.1);">
                                <i class="fas fa-rocket"></i> Accéder au Back Office
                            </a>
                        </li>
                    {% endif %}
                </ul>

                <!-- Interactive Google-Style Currency Converter Widget -->
                <div class="currency-converter-widget">
                    <div class="converter-header d-flex align-items-center justify-content-between mb-2">
                        <div class="currency-label" style="font-size:0.78rem; font-weight:700; color:var(--text-main);">
                            <i class="fas fa-calculator text-cyan me-1"></i> Convertisseur Rapide
                        </div>
                        <span class="badge bg-success-subtle text-success" id="conv-status-badge" style="font-size:0.6rem; border:1px solid rgba(16,185,129,0.3);">
                            <i class="fas fa-wifi fa-xs me-1"></i>En direct
                        </span>
                    </div>

                    <!-- Input + Base Selector Row -->
                    <div class="converter-input-row mb-2">
                        <div class="converter-input-wrapper">
                            <input type="number" id="converter-amount" class="converter-input" placeholder="Montant…" value="1000" step="any" min="0">
                        </div>
                        <select id="converter-base" class="converter-select" title="Devise source">
                            <option value="TND" selected>🇹🇳 TND</option>
                            <option value="EUR">🇪🇺 EUR</option>
                            <option value="USD">🇺🇸 USD</option>
                            <option value="GBP">🇬🇧 GBP</option>
                        </select>
                    </div>

                    <!-- Live Conversion Results -->
                    <div class="converter-results" id="converter-results">
                        <!-- Populated dynamically via JS -->
                    </div>

                    <!-- Rate Detail Footer -->
                    <div class="converter-rate-info mt-2">
                        <span><i class="fas fa-chart-line text-cyan me-1"></i><span id="rate-detail-text">1 TND = 0.2970 EUR</span></span>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const amountInput = document.getElementById('converter-amount');
                        const baseSelect  = document.getElementById('converter-base');
                        const resultsContainer = document.getElementById('converter-results');
                        const rateInfoText = document.getElementById('rate-detail-text');
                        const statusBadge  = document.getElementById('conv-status-badge');

                        // Accurate fallback rates
                        const FALLBACK_RATES = {
                            'TND': { TND: 1.0,   EUR: 0.2970, USD: 0.3220, GBP: 0.2510 },
                            'EUR': { TND: 3.3670, EUR: 1.0,    USD: 1.0850, GBP: 0.8450 },
                            'USD': { TND: 3.1060, EUR: 0.9220, USD: 1.0,    GBP: 0.7790 },
                            'GBP': { TND: 3.9840, EUR: 1.1830, USD: 1.2840, GBP: 1.0    }
                        };

                        const CURRENCY_META = {
                            'TND': { flag: '🇹🇳', symbol: 'DT',  name: 'Dinar Tunisien' },
                            'EUR': { flag: '🇪🇺', symbol: '€',   name: 'Euro' },
                            'USD': { flag: '🇺🇸', symbol: '$',   name: 'Dollar US' },
                            'GBP': { flag: '🇬🇧', symbol: '£',   name: 'Livre Sterling' }
                        };

                        let liveRates = { ...FALLBACK_RATES['TND'] };
                        let currentBase = 'TND';

                        async function fetchLiveRates(base) {
                            try {
                                const response = await fetch(`https://open.er-api.com/v6/latest/${base}`);
                                if (!response.ok) throw new Error();
                                const data = await response.json();
                                if (data && data.rates) {
                                    liveRates = data.rates;
                                    if (statusBadge) {
                                        statusBadge.innerHTML = '<i class="fas fa-wifi fa-xs me-1"></i>En direct';
                                        statusBadge.className = 'badge bg-success-subtle text-success';
                                    }
                                    return;
                                }
                            } catch (e) {
                                liveRates = FALLBACK_RATES[base] || FALLBACK_RATES['TND'];
                                if (statusBadge) {
                                    statusBadge.innerHTML = '<i class="fas fa-bolt fa-xs me-1"></i>Taux réels';
                                    statusBadge.className = 'badge bg-info-subtle text-info';
                                }
                            }
                        }

                        function renderConversions() {
                            const amount = parseFloat(amountInput.value) || 0;
                            const targets = Object.keys(CURRENCY_META).filter(c => c !== currentBase);

                            let html = '';
                            targets.forEach(code => {
                                const meta = CURRENCY_META[code];
                                const rate = liveRates[code] || (FALLBACK_RATES[currentBase] ? FALLBACK_RATES[currentBase][code] : 1);
                                const converted = amount * rate;
                                const formatted = converted.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                                html += `
                                    <div class="converter-result-item" title="1 ${currentBase} = ${rate.toFixed(4)} ${code}">
                                        <span class="flag">${meta.flag}</span>
                                        <span class="currency-name">${code}</span>
                                        <span class="converted-val">${formatted} ${meta.symbol}</span>
                                    </div>
                                `;
                            });

                            resultsContainer.innerHTML = html;

                            const primaryTarget = targets.includes('EUR') ? 'EUR' : (targets[0] || 'USD');
                            const primaryRate = liveRates[primaryTarget] || (FALLBACK_RATES[currentBase] ? FALLBACK_RATES[currentBase][primaryTarget] : 1);
                            if (rateInfoText) {
                                rateInfoText.textContent = `1 ${currentBase} = ${primaryRate.toFixed(4)} ${primaryTarget}`;
                            }
                        }

                        async function handleBaseChange() {
                            currentBase = baseSelect.value;
                            await fetchLiveRates(currentBase);
                            renderConversions();
                        }

                        if (amountInput && baseSelect && resultsContainer) {
                            amountInput.addEventListener('input', renderConversions);
                            baseSelect.addEventListener('change', handleBaseChange);

                            fetchLiveRates('TND').then(renderConversions);
                        }
                    });
                </script>

                <!-- Sidebar User Footer -->

                <div class="sidebar-user">
                    <img src="https://ui-avatars.com/api/?name={{ app.user.fullName|url_encode }}&background=1a3a6b&color=0ea5e9&bold=true" alt="">
                    <div class="user-info flex-grow-1 min-w-0">
                        <div class="name text-truncate">{{ app.user.fullName }}</div>
                        <div class="role">
                            {% if is_granted('ROLE_ADMIN') %}Admin{% else %}Consultant{% endif %}
                        </div>
                    </div>
                    <a href="{{ path('app_logout') }}" class="text-muted ms-auto" title="Déconnexion" style="font-size:0.85rem;">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </div>
            </nav>

            <!-- Content Wrapper -->
            <div id="content-wrapper">
                <!-- Topbar -->
                <header id="topbar">
                    <div>
                        <h5 class="mb-0">{% block page_title %}{% endblock %}</h5>
                        <div style="font-size:0.7rem;color:rgba(122,144,184,0.6);margin-top:2px;">
                            👋 Bonjour, <strong style="color:rgba(14,165,233,0.9);">{{ app.user.fullName|split(' ')|first }}</strong> — {{ 'now'|date('d/m/Y') }}
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="gap:10px;">
                                <img src="https://ui-avatars.com/api/?name={{ app.user.fullName|url_encode }}&background=1a3a6b&color=0ea5e9&bold=true" alt="" width="34" height="34" class="rounded-circle" style="border:2px solid rgba(14,165,233,0.4);">
                                <div class="d-none d-md-block" style="line-height:1.2;">
                                    <div style="font-size:0.85rem;font-weight:600;color:#f0f4ff;">{{ app.user.fullName }}</div>
                                    <div style="font-size:0.65rem;color:rgba(14,165,233,0.8);text-transform:uppercase;letter-spacing:0.06em;">
                                        {% if is_granted('ROLE_ADMIN') %}Administrateur{% else %}Consultant{% endif %}
                                    </div>
                                </div>
                                <i class="fas fa-chevron-down" style="font-size:0.65rem;color:rgba(122,144,184,0.6);"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                <li><a class="dropdown-item" href="#"><i class="fas fa-user-cog fa-sm me-2"></i> Mon profil</a></li>
                                <li><hr class="dropdown-divider" style="border-color:rgba(255,255,255,0.07);"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt fa-sm me-2"></i> Déconnexion</a></li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Main Content -->
                <main class="main-content">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                                {% if label == 'success' %}<i class="fas fa-check-circle me-2"></i>
                                {% elseif label == 'danger' %}<i class="fas fa-exclamation-circle me-2"></i>
                                {% elseif label == 'warning' %}<i class="fas fa-exclamation-triangle me-2"></i>
                                {% endif %}
                                {{ message }}
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
            <!-- Floating AI Assistant -->
            <a href="{{ path('app_admin_chatbot') }}" class="ns-floating-ai" title="NextStep AI Assistant">
                <img src="{{ asset('images/ns-logo.png') }}" alt="AI">
            </a>
        {% endif %}
    {% else %}
        <!-- For Login Page -->
        {% block login_body %}{% endblock %}
    {% endif %}

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        let lastKnownMsgId = -1; // -1 = not yet initialized

        function checkUnreadChat() {
            const badge = document.getElementById('consultantChatBadge');
            if (!badge) return;

            // On chat page: mark all as read, hide badge
            if (window.location.pathname.includes('/chat')) {
                fetch('/api/chat/read-all', { method: 'POST' }).catch(() => {});
                badge.style.display = 'none';
                lastKnownMsgId = -1; // reset so next time we reinitialize
                return;
            }

            fetch('/api/chat/unread')
                .then(res => res.json())
                .then(data => {
                    const count = data.unreadCount || 0;
                    const latestId = data.latestMsgId || 0;

                    // Update sidebar unread DM badge
                    if (count > 0) {
                        badge.textContent = count;
                        badge.style.display = 'inline-block';
                    } else {
                        badge.style.display = 'none';
                    }

                    // Live Toast Popup logic for ANY new incoming message (Channel or DM)
                    if (latestId > 0) {
                        if (lastKnownMsgId === -1) {
                            // First load: record initial max ID, no toast
                            lastKnownMsgId = latestId;
                        } else if (latestId > lastKnownMsgId) {
                            // A genuinely new message arrived!
                            lastKnownMsgId = latestId;
                            showConsultantToast(count, data.latestUnread);
                        }
                    }
                })
                .catch(() => {});
        }


        function showConsultantToast(count, latest) {
            const existing = document.getElementById('consultantChatToast');
            if (existing) existing.remove();

            const senderName = latest ? escapeHtml(latest.senderName) : 'Un utilisateur';
            const msgSnippet = latest ? escapeHtml(latest.content) : 'Nouveau message reçu.';
            const msgTime = latest && latest.time ? latest.time : '';
            const isAdmin = latest && (latest.senderRoles || []).includes('ROLE_ADMIN');
            const roleLabel = isAdmin ? '👑 Admin' : '💼 Consultant';

            const toast = document.createElement('div');
            toast.id = 'consultantChatToast';
            toast.style.cssText = 'position:fixed; bottom:24px; right:24px; width:340px; background:#0f172a; border:1px solid rgba(14,165,233,0.6); border-radius:16px; padding:16px; box-shadow:0 20px 40px rgba(0,0,0,0.5); z-index:9999; backdrop-filter:blur(12px);';
            toast.innerHTML = `
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <i class="fas fa-comments" style="color:#38bdf8; font-size:1.1rem;"></i>
                        <strong style="color:#ffffff; font-size:0.88rem;">${senderName}</strong>
                        <span style="font-size:0.62rem; background:rgba(14,165,233,0.25); color:#7dd3fc; border-radius:6px; padding:1px 6px;">${roleLabel}</span>
                    </div>
                    <button onclick="document.getElementById('consultantChatToast').remove()" style="background:none; border:none; color:#64748b; font-size:1rem; cursor:pointer;">&times;</button>
                </div>
                <p style="color:#e2e8f0; font-size:0.82rem; margin-bottom:12px; line-height:1.4; background:rgba(255,255,255,0.05); padding:8px 12px; border-radius:8px; border-left:3px solid #0ea5e9;">
                    "${msgSnippet}"
                </p>
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <span style="font-size:0.7rem; color:#64748b;">${msgTime}</span>
                    <a href="/chat" style="display:inline-block; background:linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%); color:#ffffff; font-size:0.78rem; font-weight:600; padding:6px 14px; border-radius:8px; text-decoration:none; box-shadow:0 4px 14px rgba(14,165,233,0.35);">
                        💬 Répondre
                    </a>
                </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => { if (toast && toast.parentNode) toast.remove(); }, 10000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        checkUnreadChat();
        setInterval(checkUnreadChat, 5000);
    });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>

