<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Cloud Billing{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    {% block stylesheets %}{% endblock %}
    
    {{ importmap('app') }}
</head>
<body>
    {% if app.user %}
        <div id="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar">
                <div class="sidebar-brand d-flex align-items-center justify-content-center py-4 px-3 mb-3 border-bottom border-secondary border-opacity-25">
                    <i class="fas fa-cloud text-accent fs-3 me-2"></i>
                    <span class="fs-4 fw-bold">CloudBill</span>
                </div>
                
                <ul class="nav flex-column mb-auto">
                    <li class="nav-item">
                        <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                            <i class="fas fa-chart-pie"></i> Dashboard
                        </a>
                    </li>
                    
                    <h6 class="sidebar-heading px-3 mt-4 mb-2 text-muted text-uppercase fs-7 fw-bold">Gestion</h6>
                    <li class="nav-item">
                        <a href="{{ path('app_company_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_company' %}active{% endif %}">
                            <i class="fas fa-building"></i> Sociétés
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_project_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_project' %}active{% endif %}">
                            <i class="fas fa-project-diagram"></i> Projets (SO)
                        </a>
                    </li>
                    
                    <h6 class="sidebar-heading px-3 mt-4 mb-2 text-muted text-uppercase fs-7 fw-bold">Facturation</h6>
                    <li class="nav-item">
                        <a href="{{ path('app_invoice_history') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_invoice' %}active{% endif %}">
                            <i class="fas fa-file-invoice-dollar"></i> Factures
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_consolidated_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_consolidated' %}active{% endif %}">
                            <i class="fas fa-layer-group"></i> Facture Consolidée
                        </a>
                    </li>
                    
                    {% if is_granted('ROLE_ADMIN') %}
                        <h6 class="sidebar-heading px-3 mt-4 mb-2 text-muted text-uppercase fs-7 fw-bold">Administration</h6>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_user_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}active{% endif %}">
                                <i class="fas fa-users"></i> Utilisateurs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_audit_log') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_audit_log' %}active{% endif %}">
                                <i class="fas fa-clipboard-list"></i> Journal d'Audit
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>

            <!-- Content Wrapper -->
            <div id="content-wrapper">
                <!-- Topbar -->
                <header id="topbar">
                    <div>
                        <h5 class="mb-0 fw-semibold">{% block page_title %}{% endblock %}</h5>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="https://ui-avatars.com/api/?name={{ app.user.fullName|url_encode }}&background=6366f1&color=fff" alt="" width="32" height="32" class="rounded-circle me-2">
                                <strong>{{ app.user.fullName }}</strong>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                <li><a class="dropdown-item" href="#"><i class="fas fa-user-cog fa-sm me-2"></i> Profil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt fa-sm me-2"></i> Déconnexion</a></li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Main Content -->
                <main class="main-content">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} alert-dismissible fade show shadow-sm" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
    {% else %}
        <!-- For Login Page -->
        {% block login_body %}{% endblock %}
    {% endif %}

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
