<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facture {{ invoice.reference }} — CloudBill</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0f172a; font-family: 'Segoe UI', Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #0f172a; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="620" cellpadding="0" cellspacing="0" style="max-width: 620px; width: 100%;">

                    <!-- Logo Header -->
                    <tr>
                        <td align="center" style="padding-bottom: 32px;">
                            <table cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 16px; padding: 14px 28px;">
                                        <span style="color: #ffffff; font-size: 22px; font-weight: 700; letter-spacing: -0.5px;">
                                            ☁ CloudBill
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Main Card -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #1e293b 0%, #1a1f35 100%); border-radius: 20px; border: 1px solid rgba(99,102,241,0.3); overflow: hidden;">

                            <!-- Top accent bar -->
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="height: 4px; background: linear-gradient(90deg, #6366f1, #8b5cf6, #10b981);"></td>
                                </tr>
                            </table>

                            <!-- Content -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px;">
                                <tr>
                                    <td>

                                        <!-- Icon -->
                                        <table cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                                            <tr>
                                                <td style="background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); border-radius: 14px; padding: 14px 16px; font-size: 28px;">
                                                    🧾
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- Title -->
                                        <h1 style="color: #f1f5f9; font-size: 24px; font-weight: 700; margin: 0 0 8px 0; letter-spacing: -0.5px;">
                                            Votre facture est disponible
                                        </h1>
                                        <p style="color: #94a3b8; font-size: 15px; margin: 0 0 28px 0; line-height: 1.6;">
                                            Bonjour <strong style="color: #e2e8f0;">{{ company.name }}</strong>,<br>
                                            La facture <strong style="color: #a78bfa;">{{ invoice.reference }}</strong> pour le mois de
                                            <strong style="color: #e2e8f0;">{{ invoice.monthName }} {{ invoice.year }}</strong>
                                            a été validée et est maintenant disponible.
                                        </p>

                                        <!-- Status Badge -->
                                        <table cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                                            <tr>
                                                <td style="background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); border-radius: 8px; padding: 8px 16px;">
                                                    <span style="color: #10b981; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                                                        ✓ Facture Validée
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- Invoice Info Grid -->
                                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px; border: 1px solid rgba(99,102,241,0.2); border-radius: 12px; overflow: hidden;">
                                            <tr>
                                                <td style="background: rgba(99,102,241,0.1); padding: 12px 20px; border-bottom: 1px solid rgba(99,102,241,0.15);">
                                                    <span style="color: #94a3b8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;">Informations de la facture</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 20px;">
                                                    <table width="100%" cellpadding="0" cellspacing="0">
                                                        <tr>
                                                            <td style="padding: 6px 0; color: #64748b; font-size: 13px; width: 50%;">Référence</td>
                                                            <td style="padding: 6px 0; color: #e2e8f0; font-size: 13px; font-weight: 600; text-align: right;">{{ invoice.reference }}</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 6px 0; color: #64748b; font-size: 13px;">Projet</td>
                                                            <td style="padding: 6px 0; color: #e2e8f0; font-size: 13px; font-weight: 600; text-align: right;">{{ invoice.project.name }}</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 6px 0; color: #64748b; font-size: 13px;">Société</td>
                                                            <td style="padding: 6px 0; color: #e2e8f0; font-size: 13px; font-weight: 600; text-align: right;">{{ company.name }}</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 6px 0; color: #64748b; font-size: 13px;">Période</td>
                                                            <td style="padding: 6px 0; color: #e2e8f0; font-size: 13px; font-weight: 600; text-align: right;">{{ invoice.monthName }} {{ invoice.year }}</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 6px 0; color: #64748b; font-size: 13px;">Date de validation</td>
                                                            <td style="padding: 6px 0; color: #e2e8f0; font-size: 13px; font-weight: 600; text-align: right;">{{ invoice.validatedAt|date('d/m/Y à H:i') }}</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- Invoice Lines Table -->
                                        {% if invoice.invoiceLines|length > 0 %}
                                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px; border: 1px solid rgba(99,102,241,0.2); border-radius: 12px; overflow: hidden;">
                                            <!-- Table Header -->
                                            <tr>
                                                <td style="background: rgba(99,102,241,0.12); padding: 10px 16px; border-bottom: 1px solid rgba(99,102,241,0.2);">
                                                    <span style="color: #94a3b8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;">Détail des consommations</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 0 16px;">
                                                    <table width="100%" cellpadding="0" cellspacing="0">
                                                        <!-- Column Headers -->
                                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                                                            <td style="padding: 10px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; width: 35%;">Ressource</td>
                                                            <td style="padding: 10px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; width: 20%; text-align: center;">Qté</td>
                                                            <td style="padding: 10px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; width: 20%; text-align: right;">P.U.</td>
                                                            <td style="padding: 10px 0; color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; width: 25%; text-align: right;">Total</td>
                                                        </tr>
                                                        <!-- Lines -->
                                                        {% for line in invoice.invoiceLines %}
                                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                                                            <td style="padding: 9px 0; color: #cbd5e1; font-size: 13px;">{{ line.resourceName }}</td>
                                                            <td style="padding: 9px 0; color: #94a3b8; font-size: 13px; text-align: center;">{{ line.consumedQuantity }} {{ line.unit }}</td>
                                                            <td style="padding: 9px 0; color: #94a3b8; font-size: 13px; text-align: right;">{{ line.unitPrice|number_format(3, ',', ' ') }}</td>
                                                            <td style="padding: 9px 0; color: #e2e8f0; font-size: 13px; font-weight: 600; text-align: right;">{{ line.lineTotal|number_format(3, ',', ' ') }} {{ invoice.currency }}</td>
                                                        </tr>
                                                        {% endfor %}
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                        {% endif %}

                                        <!-- Totals Block -->
                                        <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 32px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(99,102,241,0.25); border-radius: 12px; overflow: hidden;">
                                            <tr>
                                                <td style="padding: 20px;">
                                                    <table width="100%" cellpadding="0" cellspacing="0">
                                                        <tr>
                                                            <td style="padding: 5px 0; color: #94a3b8; font-size: 14px;">Total HT</td>
                                                            <td style="padding: 5px 0; color: #e2e8f0; font-size: 14px; text-align: right; font-weight: 600;">
                                                                {{ invoice.totalHT|number_format(3, ',', ' ') }} {{ invoice.currency }}
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 5px 0; color: #94a3b8; font-size: 14px;">TVA ({{ invoice.tvaRate }}%)</td>
                                                            <td style="padding: 5px 0; color: #e2e8f0; font-size: 14px; text-align: right; font-weight: 600;">
                                                                {{ invoice.totalTVA|number_format(3, ',', ' ') }} {{ invoice.currency }}
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2" style="padding-top: 10px; border-top: 1px solid rgba(99,102,241,0.2);">
                                                                <table width="100%" cellpadding="0" cellspacing="0">
                                                                    <tr>
                                                                        <td style="color: #a78bfa; font-size: 15px; font-weight: 700;">Total TTC</td>
                                                                        <td style="text-align: right;">
                                                                            <span style="color: #10b981; font-size: 20px; font-weight: 800;">
                                                                                {{ invoice.totalTTC|number_format(3, ',', ' ') }} {{ invoice.currency }}
                                                                            </span>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- Note -->
                                        <p style="color: #475569; font-size: 12px; line-height: 1.7; margin: 0; padding: 16px; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);">
                                            📎 Cette facture a été générée automatiquement par la plateforme CloudBill.
                                            Pour toute question concernant cette facture, veuillez contacter votre chargé de compte.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding-top: 28px;">
                            <p style="color: #334155; font-size: 12px; margin: 0; line-height: 1.6;">
                                © {{ "now"|date("Y") }} CloudBill Platform — Tous droits réservés<br>
                                <span style="color: #1e293b;">Cet email a été envoyé automatiquement, merci de ne pas y répondre.</span>
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>
