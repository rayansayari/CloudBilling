{% extends 'base.html.twig' %}

{% block title %}Mes Tâches — CloudBill{% endblock %}

{% block stylesheets %}
<style>
/* ═══════════════════════════════════════════════════════════
   KANBAN BOARD — Consultant (read-only assignee, can move columns)
═══════════════════════════════════════════════════════════ */
.todo-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 12px;
}
.todo-page-header h1 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    color: var(--ns-white);
    display: flex;
    align-items: center;
    gap: 10px;
}
.todo-page-header p { margin: 0; color: var(--ns-muted); font-size: 0.85rem; }
.todo-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
}
@media (max-width: 900px) { .todo-board { grid-template-columns: 1fr; } }
.todo-col {
    background: rgba(15,23,42,0.8);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
}
.todo-col.drag-over {
    box-shadow: 0 0 0 2px #7c3aed;
    background: rgba(124,58,237,0.08);
}
.todo-col-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}
.todo-col-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--ns-white);
}
.todo-col-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
}
.col-todo     .todo-col-dot { background: #7c3aed; box-shadow: 0 0 6px #7c3aed88; }
.col-progress .todo-col-dot { background: #0ea5e9; box-shadow: 0 0 6px #0ea5e988; }
.col-done     .todo-col-dot { background: #10b981; box-shadow: 0 0 6px #10b98188; }
.todo-col-count {
    background: rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 2px 10px;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
}
.todo-col-body {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 200px;
    flex: 1;
}
/* ─── Card ─── */
.todo-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 14px 14px 14px 18px;
    cursor: grab;
    transition: all 0.2s;
    position: relative;
    user-select: none;
}
.todo-card:hover {
    background: rgba(255,255,255,0.07);
    border-color: rgba(124,58,237,0.4);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.todo-card.sortable-chosen { opacity: 0.5; cursor: grabbing; }
.todo-card.sortable-ghost {
    opacity: 0.2;
    border: 2px dashed #7c3aed;
    background: rgba(124,58,237,0.15);
}
.todo-priority-bar {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    border-radius: 12px 0 0 12px;
}
.priority-high   .todo-priority-bar { background: #ef4444; }
.priority-medium .todo-priority-bar { background: #f59e0b; }
.priority-low    .todo-priority-bar { background: #10b981; }
.todo-card-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ns-white);
    margin-bottom: 6px;
    line-height: 1.4;
}
.todo-card-desc {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.45);
    margin-bottom: 10px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.todo-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px;
}
.todo-badge {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}
.todo-badge-high   { background: rgba(239,68,68,0.15);  color: #ef4444; }
.todo-badge-medium { background: rgba(245,158,11,0.15); color: #f59e0b; }
.todo-badge-low    { background: rgba(16,185,129,0.15); color: #10b981; }
.todo-due-date {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.4);
    display: flex;
    align-items: center;
    gap: 4px;
}
.todo-due-date.overdue { color: #ef4444; }
.empty-col {
    text-align: center;
    padding: 32px 16px;
    color: rgba(255,255,255,0.2);
    font-size: 0.82rem;
}
.empty-col i { font-size: 2rem; margin-bottom: 8px; display: block; }
</style>
{% endblock %}

{% block body %}
<div class="todo-page-header">
    <div>
        <h1><i class="fas fa-list-check" style="color:#7c3aed;"></i> Mes Tâches</h1>
        <p>Retrouvez ici toutes les tâches qui vous ont été assignées.</p>
    </div>
    <div style="display:flex; gap:8px; font-size:0.8rem; color:rgba(255,255,255,0.4);">
        <span>Glissez vos cartes pour changer leur statut</span>
        <i class="fas fa-hand-pointer"></i>
    </div>
</div>

{# Stats rapides #}
<div class="row g-3 mb-4">
    <div class="col-4">
        <div style="background:rgba(124,58,237,0.1); border:1px solid rgba(124,58,237,0.2); border-radius:12px; padding:14px; text-align:center;">
            <div style="font-size:1.5rem; font-weight:700; color:#7c3aed;">{{ todoTasks.todo|length }}</div>
            <div style="font-size:0.75rem; color:rgba(255,255,255,0.5);">À faire</div>
        </div>
    </div>
    <div class="col-4">
        <div style="background:rgba(14,165,233,0.1); border:1px solid rgba(14,165,233,0.2); border-radius:12px; padding:14px; text-align:center;">
            <div style="font-size:1.5rem; font-weight:700; color:#0ea5e9;">{{ todoTasks.in_progress|length }}</div>
            <div style="font-size:0.75rem; color:rgba(255,255,255,0.5);">En cours</div>
        </div>
    </div>
    <div class="col-4">
        <div style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.2); border-radius:12px; padding:14px; text-align:center;">
            <div style="font-size:1.5rem; font-weight:700; color:#10b981;">{{ todoTasks.done|length }}</div>
            <div style="font-size:0.75rem; color:rgba(255,255,255,0.5);">Terminées</div>
        </div>
    </div>
</div>

{# ─── Kanban Board ─── #}
<div class="todo-board">

    {# À faire #}
    <div class="todo-col col-todo" data-status="todo">
        <div class="todo-col-header">
            <div class="todo-col-title"><span class="todo-col-dot"></span> À faire</div>
            <span class="todo-col-count" id="count-todo">{{ todoTasks.todo|length }}</span>
        </div>
        <div class="todo-col-body" id="list-todo">
            {% for task in todoTasks.todo %}
                {{ _self.taskCard(task) }}
            {% else %}
                <div class="empty-col"><i class="fas fa-inbox"></i>Aucune tâche</div>
            {% endfor %}
        </div>
    </div>

    {# En cours #}
    <div class="todo-col col-progress" data-status="in_progress">
        <div class="todo-col-header">
            <div class="todo-col-title"><span class="todo-col-dot"></span> En cours</div>
            <span class="todo-col-count" id="count-in_progress">{{ todoTasks.in_progress|length }}</span>
        </div>
        <div class="todo-col-body" id="list-in_progress">
            {% for task in todoTasks.in_progress %}
                {{ _self.taskCard(task) }}
            {% else %}
                <div class="empty-col"><i class="fas fa-spinner"></i>Aucune tâche</div>
            {% endfor %}
        </div>
    </div>

    {# Terminé #}
    <div class="todo-col col-done" data-status="done">
        <div class="todo-col-header">
            <div class="todo-col-title"><span class="todo-col-dot"></span> Terminé</div>
            <span class="todo-col-count" id="count-done">{{ todoTasks.done|length }}</span>
        </div>
        <div class="todo-col-body" id="list-done">
            {% for task in todoTasks.done %}
                {{ _self.taskCard(task) }}
            {% else %}
                <div class="empty-col"><i class="fas fa-check-circle"></i>Aucune tâche</div>
            {% endfor %}
        </div>
    </div>
</div>

{% macro taskCard(task) %}
<div class="todo-card priority-{{ task.priority }}" id="task-{{ task.id }}" data-id="{{ task.id }}">
    <div class="todo-priority-bar"></div>
    <div class="todo-card-title">{{ task.title }}</div>
    {% if task.description %}
        <div class="todo-card-desc">{{ task.description }}</div>
    {% endif %}
    <div class="todo-card-footer">
        <span class="todo-badge todo-badge-{{ task.priority }}">
            {{ task.priority == 'high' ? 'Haute' : (task.priority == 'medium' ? 'Moyenne' : 'Basse') }}
        </span>
        {% if task.dueDate %}
            <div class="todo-due-date {{ task.overdue ? 'overdue' }}">
                <i class="fas fa-calendar-alt"></i>
                {{ task.dueDate|date('d/m/Y') }}
                {% if task.overdue %}<span style="color:#ef4444;">(En retard)</span>{% endif %}
            </div>
        {% endif %}
    </div>
</div>
{% endmacro %}
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
const lists = ['todo', 'in_progress', 'done'];
lists.forEach(status => {
    const el = document.getElementById(`list-${status}`);
    if (!el) return;
    Sortable.create(el, {
        group       : 'tasks',
        animation   : 180,
        ghostClass  : 'sortable-ghost',
        chosenClass : 'sortable-chosen',
        delay       : 50,
        delayOnTouchOnly: true,
        onEnd(evt) {
            const taskId    = evt.item.dataset.id;
            const newStatus = evt.to.closest('.todo-col').dataset.status;
            const newPos    = evt.newIndex;

            // Update counters
            lists.forEach(s => {
                const cnt = document.getElementById(`list-${s}`)?.querySelectorAll('.todo-card').length ?? 0;
                const el  = document.getElementById(`count-${s}`);
                if (el) el.textContent = cnt;
            });

            fetch(`/todo/${taskId}/move`, {
                method : 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body   : JSON.stringify({ status: newStatus, position: newPos }),
            }).catch(() => alert('Erreur lors du déplacement.'));
        }
    });
});
</script>
{% endblock %}
