{% extends 'base.html.twig' %}

{% block title %}Projets (SO) - CloudBill{% endblock %}
{% block page_title %}Gestion des Projets{% endblock %}

{% block stylesheets %}
<style>
/* CSS Spécifique pour les Cartes Projets (Front Office) */
.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
}

.project-card {
    background: rgba(15, 28, 54, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 1.5rem;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
}

.project-card:hover {
    transform: translateY(-4px);
    background: rgba(20, 36, 65, 0.9);
    border-color: rgba(26, 111, 212, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(26,111,212,0.15);
}

.project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
}

.project-so {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ns-cyan);
    background: rgba(14, 165, 233, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.05em;
}

.project-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    margin: 0.5rem 0;
    line-height: 1.3;
}

.project-company {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
}

.project-company:hover { color: var(--text-main); }
.project-company i { color: var(--ns-cyan); }

.project-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    flex-grow: 1;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
}

.detail-label { color: rgba(122, 144, 184, 0.7); display: flex; align-items: center; gap: 6px; }
.detail-value { color: #fff; font-weight: 600; }

.project-actions {
    display: flex;
    gap: 8px;
    margin-top: 1.5rem;
}
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 animate-in">
    <form method="get" class="d-flex w-50">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" name="q" value="{{ search_query }}" class="form-control border-start-0 ps-0" placeholder="Rechercher par SO, nom...">
            <button type="submit" class="btn btn-outline-secondary">Chercher</button>
        </div>
    </form>
    
    <a href="{{ path('app_project_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouveau Projet
    </a>
</div>

<div class="project-grid">
    {% for project in pagination %}
        <div class="project-card animate-in">
            <div class="project-header">
                <div class="project-so">{{ project.soNumber }}</div>
                <div>
                    {% if project.status == 'Actif' %}
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25"><div class="status-dot active"></div>Actif</span>
                    {% elseif project.status == 'En pause' %}
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25"><div class="status-dot warning"></div>En pause</span>
                    {% else %}
                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25"><div class="status-dot inactive"></div>{{ project.status }}</span>
                    {% endif %}
                </div>
            </div>
            
            <h3 class="project-title text-truncate" title="{{ project.name }}">{{ project.name }}</h3>
            
            <a href="{{ path('app_company_show', {'id': project.company.id}) }}" class="project-company">
                <i class="fas fa-building"></i> {{ project.company.name }}
            </a>
            
            <div class="project-details">
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-calendar-alt"></i> Date de début</span>
                    <span class="detail-value">{{ project.startDate|date('d/m/Y') }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-file-contract"></i> Offre active</span>
                    <span class="detail-value">
                        {% if project.activeOffer %}
                            <span class="text-success"><i class="fas fa-check-circle"></i> V{{ project.activeOffer.version }}</span>
                        {% else %}
                            <span class="text-danger"><i class="fas fa-times-circle"></i> Aucune</span>
                        {% endif %}
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-file-invoice"></i> Factures générées</span>
                    <span class="detail-value">{{ project.invoices|length }}</span>
                </div>
            </div>
            
            <div class="project-actions">
                <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-primary flex-grow-1">
                    Ouvrir le dossier <i class="fas fa-arrow-right ms-1 fs-7"></i>
                </a>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <div class="glass-card p-5 d-inline-block">
                <i class="fas fa-diagram-project fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-semibold">Aucun projet trouvé</h5>
                <p class="text-muted mb-0">Créez votre premier projet (SO) pour commencer à facturer.</p>
            </div>
        </div>
    {% endfor %}
</div>

<div class="d-flex justify-content-center mt-5">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
