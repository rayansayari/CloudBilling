{% extends 'base.html.twig' %}

{% block title %}Projets (SO) - CloudBill{% endblock %}
{% block page_title %}Gestion des Projets{% endblock %}

{% block stylesheets %}
<style>
/* ========== PROJECT GRID ========== */
.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
}

.project-card {
    background: rgba(15, 28, 54, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    padding: 0;
    position: relative;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    overflow: hidden;
    animation: cardFadeIn 0.4s ease both;
}

.project-card:nth-child(2) { animation-delay: 0.05s; }
.project-card:nth-child(3) { animation-delay: 0.10s; }
.project-card:nth-child(4) { animation-delay: 0.15s; }
.project-card:nth-child(5) { animation-delay: 0.20s; }

@keyframes cardFadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

.project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 30px var(--status-glow, rgba(26,111,212,0.2));
    border-color: var(--status-color, rgba(26,111,212,0.4));
}

/* Bande colorée selon statut */
.project-card-top {
    height: 5px;
    background: var(--status-color, #1a6fd4);
    position: relative;
}
.project-card-top::after {
    content: '';
    position: absolute;
    inset: 0;
    background: inherit;
    filter: blur(8px);
    opacity: 0.5;
    transform: scaleY(3);
}

.project-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
}

.project-so {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--ns-cyan);
    background: rgba(14, 165, 233, 0.12);
    border: 1px solid rgba(14, 165, 233, 0.25);
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.project-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin: 0.6rem 0 0.4rem;
    line-height: 1.3;
}

.project-company {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    color: rgba(122,144,184,0.8);
    text-decoration: none;
    transition: color 0.2s;
    margin-bottom: 1.25rem;
}
.project-company:hover { color: #e2e8f0; }
.project-company i { color: var(--ns-cyan); font-size: 0.75rem; }

.project-details {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem;
    background: rgba(0,0,0,0.2);
    border-radius: 12px;
    margin-bottom: 1.25rem;
    flex-grow: 1;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
}

.detail-label {
    color: rgba(122, 144, 184, 0.6);
    display: flex;
    align-items: center;
    gap: 7px;
}
.detail-label i { width: 14px; text-align: center; font-size: 0.75rem; }
.detail-value { color: #fff; font-weight: 600; }

/* No-offer alert pulsing */
.no-offer-alert {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #f87171;
    background: rgba(239,68,68,0.1);
    border: 1px solid rgba(239,68,68,0.25);
    border-radius: 8px;
    padding: 4px 10px;
    animation: pulseAlert 2s ease-in-out infinite;
}
@keyframes pulseAlert {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
}

/* Invoice count badge */
.invoice-count {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(26,111,212,0.15);
    border: 1px solid rgba(26,111,212,0.25);
    color: #60a5fa;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Action button */
.btn-open-project {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: linear-gradient(135deg, rgba(26,111,212,0.2), rgba(59,130,246,0.2));
    border: 1px solid rgba(26,111,212,0.35);
    color: #60a5fa;
    border-radius: 10px;
    padding: 0.6rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
}
.btn-open-project:hover {
    background: linear-gradient(135deg, rgba(26,111,212,0.4), rgba(59,130,246,0.4));
    border-color: #60a5fa;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26,111,212,0.4);
}
.btn-open-project .arrow-icon { transition: transform 0.3s ease; }
.btn-open-project:hover .arrow-icon { transform: translateX(5px); }

/* ========== SEARCH BAR ========== */
.search-bar-wrapper {
    position: relative;
    flex: 1;
    max-width: 420px;
}
.search-bar-wrapper .search-icon {
    position: absolute;
    left: 14px; top: 50%;
    transform: translateY(-50%);
    color: rgba(122,144,184,0.5);
    font-size: 0.85rem;
    pointer-events: none;
    z-index: 2;
}
.search-bar-wrapper input {
    width: 100%;
    background: rgba(10, 20, 45, 0.8);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    color: #e2e8f0;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    outline: none;
}
.search-bar-wrapper input:focus {
    border-color: rgba(26,111,212,0.5);
    box-shadow: 0 0 0 3px rgba(26,111,212,0.15);
    background: rgba(15, 28, 54, 0.95);
}
.search-bar-wrapper input::placeholder { color: rgba(122,144,184,0.4); }
.btn-search-go {
    background: linear-gradient(135deg, var(--accent), #3b82f6);
    border: none;
    border-radius: 10px;
    color: #fff;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 12px rgba(26,111,212,0.3);
}
.btn-search-go:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(26,111,212,0.5);
}
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 animate-in" style="gap:1rem; position:relative; z-index: 200;">
    <form method="get" class="d-flex align-items-center gap-2" style="flex:1;max-width:480px;">
        <div class="search-bar-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher par SO, nom...">
        </div>
        <button type="submit" class="btn-search-go">
            <i class="fas fa-search"></i> Chercher
        </button>
    </form>

    <div class="dropdown me-auto" style="position: relative; z-index: 1050;">
        <button class="btn-sort dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="fas fa-sort-amount-down"></i> Trier par
        </button>
        <ul class="dropdown-menu dropdown-menu-dark shadow">
            <li>{{ knp_pagination_sortable(pagination, 'N° SO (Croissant)', 'p.soNumber', {'direction': 'asc'}, {'class': 'dropdown-item'}) }}</li>
            <li>{{ knp_pagination_sortable(pagination, 'N° SO (Décroissant)', 'p.soNumber', {'direction': 'desc'}, {'class': 'dropdown-item'}) }}</li>
            <li><hr class="dropdown-divider"></li>
            <li>{{ knp_pagination_sortable(pagination, 'Nom (A-Z)', 'p.name', {'direction': 'asc'}, {'class': 'dropdown-item'}) }}</li>
            <li>{{ knp_pagination_sortable(pagination, 'Nom (Z-A)', 'p.name', {'direction': 'desc'}, {'class': 'dropdown-item'}) }}</li>
            <li><hr class="dropdown-divider"></li>
            <li>{{ knp_pagination_sortable(pagination, 'Début (Plus récent)', 'p.startDate', {'direction': 'desc'}, {'class': 'dropdown-item'}) }}</li>
            <li>{{ knp_pagination_sortable(pagination, 'Début (Plus ancien)', 'p.startDate', {'direction': 'asc'}, {'class': 'dropdown-item'}) }}</li>
        </ul>
    </div>

    <a href="{{ path('app_project_new') }}" class="btn btn-primary" style="border-radius:10px;font-weight:600;white-space:nowrap;">
        <i class="fas fa-plus me-2"></i> Nouveau Projet
    </a>
</div>

<div class="project-grid">
    {% for project in pagination %}
        {% if project.status == 'Actif' %}
            {% set statusColor = '#10b981' %}
            {% set statusGlow  = 'rgba(16,185,129,0.25)' %}
        {% elseif project.status == 'En pause' %}
            {% set statusColor = '#f59e0b' %}
            {% set statusGlow  = 'rgba(245,158,11,0.25)' %}
        {% else %}
            {% set statusColor = '#64748b' %}
            {% set statusGlow  = 'rgba(100,116,139,0.15)' %}
        {% endif %}

        <div class="project-card" style="--status-color:{{ statusColor }};--status-glow:{{ statusGlow }};">
            <div class="project-card-top"></div>
            <div class="project-card-body">

                <div class="project-header">
                    <div class="project-so">{{ project.soNumber }}</div>
                    <div>
                        {% if project.status == 'Actif' %}
                            <span class="badge" style="background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.3);border-radius:6px;font-size:0.68rem;"><span class="status-dot active"></span>Actif</span>
                        {% elseif project.status == 'En pause' %}
                            <span class="badge" style="background:rgba(245,158,11,0.15);color:#fbbf24;border:1px solid rgba(245,158,11,0.3);border-radius:6px;font-size:0.68rem;"><span class="status-dot warning"></span>En pause</span>
                        {% else %}
                            <span class="badge" style="background:rgba(100,116,139,0.15);color:#94a3b8;border:1px solid rgba(100,116,139,0.3);border-radius:6px;font-size:0.68rem;"><span class="status-dot inactive"></span>{{ project.status }}</span>
                        {% endif %}
                    </div>
                </div>

                <h3 class="project-title text-truncate" title="{{ project.name }}">{{ project.name }}</h3>

                <a href="{{ path('app_company_show', {'id': project.company.id}) }}" class="project-company">
                    <i class="fas fa-building"></i> {{ project.company.name }}
                </a>

                <div class="project-details">
                    <div class="detail-row">
                        <span class="detail-label"><i class="fas fa-calendar-alt"></i> Début</span>
                        <span class="detail-value">{{ project.startDate|date('d/m/Y') }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label"><i class="fas fa-file-contract"></i> Offre active</span>
                        <span class="detail-value">
                            {% if project.activeOffer %}
                                <span class="text-success"><i class="fas fa-check-circle"></i> V{{ project.activeOffer.version }}</span>
                            {% else %}
                                <span class="no-offer-alert"><i class="fas fa-exclamation-triangle"></i> Aucune</span>
                            {% endif %}
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label"><i class="fas fa-file-invoice"></i> Factures</span>
                        <span class="invoice-count">
                            <i class="fas fa-receipt"></i> {{ project.invoices|length }}
                        </span>
                    </div>
                </div>

                <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn-open-project">
                    <i class="fas fa-folder-open"></i>
                    Ouvrir le dossier
                    <i class="fas fa-arrow-right arrow-icon"></i>
                </a>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <div class="glass-card p-5 d-inline-block">
                <i class="fas fa-diagram-project fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-semibold">Aucun projet trouvé</h5>
                <p class="text-muted mb-0">Créez votre premier projet (SO) pour commencer à facturer.</p>
            </div>
        </div>
    {% endfor %}
</div>

<div class="d-flex justify-content-center mt-5">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
