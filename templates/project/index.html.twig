{% extends 'base.html.twig' %}

{% block title %}Projets (SO) - CloudBill{% endblock %}
{% block page_title %}Gestion des Projets{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <form method="get" class="d-flex w-50">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" name="q" value="{{ search_query }}" class="form-control border-start-0 ps-0" placeholder="Rechercher par SO, nom ou société...">
            <button type="submit" class="btn btn-outline-secondary">Chercher</button>
        </div>
    </form>
    
    <a href="{{ path('app_project_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouveau Projet
    </a>
</div>

<div class="glass-card overflow-hidden">
    <table class="table table-dark table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>N° SO</th>
                <th>Nom du Projet</th>
                <th>Société</th>
                <th>Statut</th>
                <th>Date Début</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project in pagination %}
            <tr>
                <td class="fw-bold">{{ project.soNumber }}</td>
                <td class="fw-semibold">{{ project.name }}</td>
                <td>
                    <a href="{{ path('app_company_show', {'id': project.company.id}) }}" class="text-decoration-none text-light hover-accent">
                        <i class="fas fa-building me-1 text-muted"></i> {{ project.company.name }}
                    </a>
                </td>
                <td>
                    {% set badgeColor = project.status == 'Actif' ? 'success' : (project.status == 'En pause' ? 'warning' : 'secondary') %}
                    <span class="badge bg-{{ badgeColor }} bg-opacity-25 text-{{ badgeColor }} border border-{{ badgeColor }} border-opacity-25">{{ project.status }}</span>
                </td>
                <td>{{ project.startDate|date('d/m/Y') }}</td>
                <td class="text-end">
                    <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-sm btn-outline-light border-0" title="Détails">
                        <i class="fas fa-eye text-info"></i>
                    </a>
                    <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-sm btn-outline-light border-0" title="Modifier">
                        <i class="fas fa-edit text-warning"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center py-4 text-muted">
                    <i class="fas fa-project-diagram fs-3 mb-3 d-block"></i>
                    Aucun projet trouvé.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
