<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin — CloudBill{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Back Office CSS ONLY -->
    <link rel="stylesheet" href="{{ asset('css/backoffice.css') }}">

    {% block stylesheets %}{% endblock %}
    {{ importmap('app') }}
</head>
<body class="backoffice">

<div id="adm-wrapper">

    <!-- ======= SIDEBAR (icon-only) ======= -->
    <nav id="adm-sidebar">
        <!-- Brand -->
        <div class="adm-brand">
            <img src="{{ asset('images/ns-logo.png') }}" alt="NS">
        </div>

        <!-- Main Nav -->
        <div class="adm-nav">
            <div class="adm-nav-item">
                <a href="{{ path('app_admin_dashboard') }}" class="adm-nav-link {% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}active{% endif %}" data-tooltip="Dashboard Admin">
                    <i class="fas fa-gauge-high"></i>
                </a>
            </div>
            <div class="adm-nav-item">
                <a href="{{ path('app_admin_chatbot') }}" class="adm-nav-link {% if app.request.attributes.get('_route') == 'app_admin_chatbot' %}active{% endif %}" data-tooltip="Assistant IA" style="color: #a78bfa;">
                    <i class="fas fa-robot"></i>
                </a>
            </div>
            <div class="adm-nav-item">
                <a href="{{ path('app_admin_company_index') }}" class="adm-nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_company' %}active{% endif %}" data-tooltip="Sociétés">
                    <i class="fas fa-building"></i>
                </a>
            </div>
            <div class="adm-nav-item">
                <a href="{{ path('app_admin_project_index') }}" class="adm-nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_project' %}active{% endif %}" data-tooltip="Projets (SO)">
                    <i class="fas fa-diagram-project"></i>
                </a>
            </div>
            <div class="adm-nav-item">
                <a href="{{ path('app_admin_invoice_history') }}" class="adm-nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_invoice' %}active{% endif %}" data-tooltip="Factures">
                    <i class="fas fa-file-invoice-dollar"></i>
                </a>
            </div>

            <div class="adm-nav-separator"></div>

            <div class="adm-nav-item">
                <a href="{{ path('app_admin_user_index') }}" class="adm-nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}active{% endif %}" data-tooltip="Utilisateurs">
                    <i class="fas fa-users"></i>
                </a>
            </div>
            <div class="adm-nav-item">
                <a href="{{ path('app_audit_log') }}" class="adm-nav-link {% if app.request.attributes.get('_route') == 'app_audit_log' %}active{% endif %}" data-tooltip="Journal d'Audit">
                    <i class="fas fa-clipboard-list"></i>
                </a>
            </div>
            <div class="adm-nav-item">
                <a href="{{ path('app_admin_todo') }}" class="adm-nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_todo' %}active{% endif %}" data-tooltip="To-Do Board" style="color:#f59e0b;">
                    <i class="fas fa-list-check"></i>
                </a>
            </div>
            <div class="adm-nav-item position-relative">
                <a href="{{ path('app_admin_chat_index') }}" class="adm-nav-link {% if app.request.attributes.get('_route') starts with 'app_admin_chat' %}active{% endif %}" data-tooltip="Chat Room" style="color:#ec4899; position:relative;">
                    <i class="fas fa-comments"></i>
                    <span id="chatSidebarBadge" class="badge rounded-pill bg-danger" style="font-size:0.55rem; padding:2px 4px; position:absolute; top:2px; right:2px; display:none;">0</span>
                </a>
            </div>

        </div>


        <!-- Bottom nav -->
        <div class="adm-nav-bottom">
            <div class="adm-nav-item">
                <a href="{{ path('app_company_index') }}" class="adm-nav-link" data-tooltip="Front Office" style="color: #0ea5e9;">
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>
            <div class="adm-nav-item" style="margin-top:4px;">
                <a href="{{ path('app_logout') }}" class="adm-nav-link" data-tooltip="Déconnexion" style="color:#ef4444;">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- ======= CONTENT AREA ======= -->
    <div id="adm-content">

        <!-- Topbar -->
        <header id="adm-topbar">
            <div class="adm-topbar-title">
                <i class="fas fa-shield-halved" style="color:rgba(124,58,237,0.6);"></i>
                {% block page_title %}Administration{% endblock %}
                <span class="adm-badge-admin">Admin</span>
            </div>
            <div class="adm-topbar-spacer"></div>

            <!-- Smart Notification Bell Widget -->
            <div class="notification-widget me-3 position-relative">
                <button id="notifBellBtn" class="position-relative" style="background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.35); color: #c4b5fd; width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;" title="Centre de Notifications (Smart Alerts)">
                    <i class="fas fa-bell" style="font-size: 1.1rem;"></i>
                    <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; padding: 3px 6px; display: none;">
                        0
                    </span>
                </button>

                <!-- Dropdown Menu -->
                <div id="notifDropdown" class="notif-dropdown shadow-lg rounded-4 overflow-hidden" style="display: none; position: absolute; right: 0; top: 48px; width: 340px; background: #0f172a; border: 1px solid rgba(124,58,237,0.4); z-index: 1050; backdrop-filter: blur(12px);">
                    <div class="p-3 d-flex align-items-center justify-content-between border-bottom" style="border-color: rgba(255,255,255,0.08) !important; background: rgba(124,58,237,0.15);">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-bell text-purple" style="color: #a78bfa;"></i>
                            <strong class="text-white" style="font-size: 0.9rem;">Smart Alerts</strong>
                        </div>
                        <span id="notifCountTag" class="badge" style="background: rgba(124,58,237,0.3); color: #c4b5fd; font-size: 0.7rem;">0 alerte(s)</span>
                    </div>

                    <div id="notifItemsContainer" style="max-height: 320px; overflow-y: auto;">
                        <div class="p-4 text-center text-muted" style="font-size: 0.82rem;">
                            <i class="fas fa-spinner fa-spin me-2"></i>Chargement des alertes...
                        </div>
                    </div>

                    <div class="p-2 text-center border-top" style="border-color: rgba(255,255,255,0.08) !important; background: rgba(15,23,42,0.8);">
                        <a href="{{ path('app_admin_dashboard') }}" class="text-decoration-none" style="font-size: 0.78rem; color: #a78bfa; font-weight: 600;">
                            <i class="fas fa-chart-line me-1"></i>Voir le Dashboard complet
                        </a>
                    </div>
                </div>
            </div>

            <div class="adm-topbar-user">
                <img src="https://ui-avatars.com/api/?name={{ app.user.fullName|url_encode }}&background=3b0764&color=a78bfa&bold=true" alt="">
                <span class="name">{{ app.user.fullName }}</span>
            </div>

        </header>

        <!-- Breadcrumb -->
        <div class="adm-breadcrumb">
            <i class="fas fa-home" style="font-size:0.6rem;"></i>
            <a href="{{ path('app_admin_dashboard') }}">Admin</a>
            {% block breadcrumb %}{% endblock %}
        </div>

        <!-- Main Content -->
        <main class="adm-main">
            <!-- Flash messages -->
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="adm-alert {{ label == 'success' ? 'success' : (label == 'danger' ? 'danger' : 'warning') }}">
                        <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'danger' ? 'exclamation-circle' : 'exclamation-triangle') }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const bellBtn = document.getElementById('notifBellBtn');
    const dropdown = document.getElementById('notifDropdown');
    const badge = document.getElementById('notifBadge');
    const countTag = document.getElementById('notifCountTag');
    const itemsContainer = document.getElementById('notifItemsContainer');

    if (!bellBtn || !dropdown) return;

    // Toggle dropdown
    bellBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const isOpen = dropdown.style.display === 'block';
        dropdown.style.display = isOpen ? 'none' : 'block';
        if (!isOpen) {
            fetchNotifications();
        }
    });

    // Close on outside click
    document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && !bellBtn.contains(e.target)) {
            dropdown.style.display = 'none';
        }
    });

    // Fetch notifications function
    function fetchNotifications() {
        fetch('/api/notifications')
            .then(res => res.json())
            .then(data => {
                // Update count badge
                if (data.totalCount > 0) {
                    badge.textContent = data.totalCount;
                    badge.style.display = 'inline-block';
                    countTag.textContent = data.totalCount + ' alerte(s)';
                } else {
                    badge.style.display = 'none';
                    countTag.textContent = 'Aucune alerte';
                }

                // Render notification items
                if (!data.items || data.items.length === 0) {
                    itemsContainer.innerHTML = `
                        <div class="p-4 text-center text-muted" style="font-size: 0.82rem;">
                            <i class="fas fa-check-circle fs-3 mb-2 text-success opacity-75"></i>
                            <p class="mb-0">Toutes les alertes sont traitées !</p>
                        </div>
                    `;
                    return;
                }

                let html = '';
                data.items.forEach(item => {
                    const bgBadge = item.type === 'danger' ? 'rgba(239,68,68,0.15)' : (item.type === 'warning' ? 'rgba(245,158,11,0.15)' : 'rgba(16,185,129,0.15)');
                    const colorBadge = item.type === 'danger' ? '#f87171' : (item.type === 'warning' ? '#fbbf24' : '#34d399');
                    const borderColor = item.type === 'danger' ? 'rgba(239,68,68,0.3)' : (item.type === 'warning' ? 'rgba(245,158,11,0.3)' : 'rgba(16,185,129,0.3)');

                    html += `
                        <a href="${item.url}" class="d-flex align-items-start gap-3 p-3 text-decoration-none border-bottom notif-item" style="border-color: rgba(255,255,255,0.05) !important; transition: background 0.2s;">
                            <div style="width: 36px; height: 36px; border-radius: 10px; background: ${bgBadge}; border: 1px solid ${borderColor}; color: ${colorBadge}; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0;">
                                <i class="${item.icon}"></i>
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                                    <strong style="color: #f8fafc; font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.title}</strong>
                                    <span style="font-size: 0.68rem; color: #64748b;">${item.date}</span>
                                </div>
                                <p class="mb-0" style="color: #94a3b8; font-size: 0.78rem; line-height: 1.4;">${item.message}</p>
                            </div>
                        </a>
                    `;
                });

                itemsContainer.innerHTML = html;
            })
            .catch(err => {
                itemsContainer.innerHTML = `
                    <div class="p-3 text-center text-danger" style="font-size: 0.8rem;">
                        <i class="fas fa-exclamation-circle me-1"></i>Erreur de chargement des alertes
                    </div>
                `;
            });
    }

    let lastKnownMsgId = -1; // -1 = not yet initialized

    // Fetch unread chat messages & trigger toast ONLY when a truly NEW message arrives
    function fetchUnreadChat() {
        const chatBadge = document.getElementById('chatSidebarBadge');
        if (!chatBadge) return;

        // On chat page: mark all as read, hide badge
        if (window.location.pathname.includes('/admin/chat')) {
            fetch('/api/chat/read-all', { method: 'POST' }).catch(() => {});
            chatBadge.style.display = 'none';
            lastKnownMsgId = -1; // reset so next time we reinitialize
            return;
        }

        fetch('/api/chat/unread')
            .then(res => res.json())
            .then(data => {
                const count = data.unreadCount || 0;
                const latestId = data.latestMsgId || 0;

                console.log('[Chat Poll Admin] latestMsgId='+latestId+' lastKnownMsgId='+lastKnownMsgId+' count='+count);

                // Update sidebar unread DM badge
                if (count > 0) {
                    chatBadge.textContent = count;
                    chatBadge.style.display = 'inline-block';
                } else {
                    chatBadge.style.display = 'none';
                }

                // Live Toast Popup logic for ANY new incoming message (Channel or DM)
                if (latestId > 0) {
                    if (lastKnownMsgId === -1) {
                        // First load: record initial max ID, no toast
                        lastKnownMsgId = latestId;
                    } else if (latestId > lastKnownMsgId) {
                        // A genuinely new message arrived!
                        lastKnownMsgId = latestId;
                        showChatToast(count, data.latestUnread);
                    }
                }
            })
            .catch(() => {});
    }


    function showChatToast(count, latest) {
        const existing = document.getElementById('chatToastPopup');
        if (existing) existing.remove();

        const senderName = latest ? escapeHtml(latest.senderName) : 'Un utilisateur';
        const msgSnippet = latest ? escapeHtml(latest.content) : 'Nouveau message reçu.';
        const msgTime = latest && latest.time ? latest.time : '';
        const isAdmin = latest && (latest.senderRoles || []).includes('ROLE_ADMIN');
        const roleLabel = isAdmin ? '👑 Admin' : '💼 Consultant';

        const toast = document.createElement('div');
        toast.id = 'chatToastPopup';
        toast.style.cssText = 'position:fixed; bottom:24px; right:24px; width:340px; background:#0f172a; border:1px solid rgba(124,58,237,0.6); border-radius:16px; padding:16px; box-shadow:0 20px 40px rgba(0,0,0,0.5); z-index:9999; backdrop-filter:blur(12px); animation: fadeInUp 0.3s ease-out;';
        toast.innerHTML = `
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-comments" style="color:#a78bfa; font-size:1.1rem;"></i>
                    <strong style="color:#ffffff; font-size:0.88rem;">${senderName}</strong>
                    <span style="font-size:0.62rem; background:rgba(124,58,237,0.25); color:#c4b5fd; border-radius:6px; padding:1px 6px;">${roleLabel}</span>
                </div>
                <button onclick="document.getElementById('chatToastPopup').remove()" style="background:none; border:none; color:#64748b; font-size:1rem; cursor:pointer;">&times;</button>
            </div>
            <p style="color:#e2e8f0; font-size:0.82rem; margin-bottom:12px; line-height:1.4; background:rgba(255,255,255,0.05); padding:8px 12px; border-radius:8px; border-left:3px solid #7c3aed;">
                "${msgSnippet}"
            </p>
            <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="font-size:0.7rem; color:#64748b;">${msgTime}</span>
                <a href="/admin/chat" style="display:inline-block; background:linear-gradient(135deg, #7c3aed 0%, #ec4899 100%); color:#ffffff; font-size:0.78rem; font-weight:600; padding:6px 14px; border-radius:8px; text-decoration:none; box-shadow:0 4px 14px rgba(124,58,237,0.35);">
                    💬 Répondre
                </a>
            </div>
        `;
        document.body.appendChild(toast);

        setTimeout(() => {
            if (toast && toast.parentNode) toast.remove();
        }, 10000);
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }



    // Initial fetch on page load
    fetchNotifications();
    fetchUnreadChat();

    // Poll every 5 seconds for instant chat notification toast
    setInterval(fetchNotifications, 30000);
    setInterval(fetchUnreadChat, 5000);
});
</script>
{% block javascripts %}{% endblock %}
</body>
</html>



