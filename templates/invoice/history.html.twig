{% extends 'base.html.twig' %}

{% block title %}Historique des factures - CloudBill{% endblock %}
{% block page_title %}Historique des factures{% endblock %}

{% block body %}
<div class="glass-card overflow-hidden">
    <table class="table table-dark table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Référence</th>
                <th>Projet</th>
                <th>Période</th>
                <th>Statut</th>
                <th class="text-end">Total TTC</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for invoice in pagination %}
            <tr>
                <td class="align-middle fw-medium">
                    <i class="fas fa-file-invoice text-accent me-2"></i>
                    {{ invoice.reference }}
                </td>
                <td class="align-middle">
                    <a href="{{ path('app_project_show', {'id': invoice.project.id}) }}" class="text-light text-decoration-none">
                        {{ invoice.project.name }}
                    </a>
                </td>
                <td class="align-middle text-muted">
                    {{ invoice.monthName }} {{ invoice.year }}
                </td>
                <td class="align-middle">
                    {% if invoice.status == 'Validée' %}
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25"><i class="fas fa-check-circle me-1"></i> Validée</span>
                    {% else %}
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25"><i class="fas fa-clock me-1"></i> Brouillon</span>
                    {% endif %}
                </td>
                <td class="align-middle text-end text-light fw-bold">
                    {{ invoice.totalTTC|number_format(2, ',', ' ') }} €
                </td>
                <td class="align-middle text-end">
                    <a href="{{ path('app_invoice_edit', {'project_id': invoice.project.id, 'id': invoice.id}) }}" class="btn btn-sm btn-outline-info" title="Voir / Éditer">
                        <i class="fas fa-eye"></i>
                    </a>
                    {% if invoice.status == 'Validée' %}
                        <a href="{{ path('app_invoice_export_pdf', {'project_id': invoice.project.id, 'id': invoice.id}) }}" class="btn btn-sm btn-outline-danger ms-1" title="PDF" target="_blank">
                            <i class="fas fa-file-pdf"></i>
                        </a>
                        <a href="{{ path('app_invoice_export_excel', {'project_id': invoice.project.id, 'id': invoice.id}) }}" class="btn btn-sm btn-outline-success ms-1" title="Excel">
                            <i class="fas fa-file-excel"></i>
                        </a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center py-4 text-muted">Aucune facture générée pour le moment.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
