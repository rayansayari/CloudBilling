{% extends 'base.html.twig' %}

{% block title %}Facture {{ invoice.reference }} - CloudBill{% endblock %}
{% block page_title %}Édition de Facture{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">{{ invoice.reference }}</h4>
        <p class="text-muted mb-0">Projet : <a href="{{ path('app_project_show', {'id': project.id}) }}" class="text-light text-decoration-none hover-accent">{{ project.soNumber }}</a> — {{ invoice.monthName }} {{ invoice.year }}</p>
    </div>
    <div class="d-flex gap-2">
        {% if invoice.status == 'Validée' %}
            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 fs-6 px-3 py-2 d-flex align-items-center">
                <i class="fas fa-lock me-2"></i> Validée
            </span>
            <a href="{{ path('app_invoice_export_pdf', {'project_id': project.id, 'id': invoice.id}) }}" class="btn btn-outline-danger"><i class="fas fa-file-pdf me-2"></i> Exporter PDF</a>
            <a href="{{ path('app_invoice_export_excel', {'project_id': project.id, 'id': invoice.id}) }}" class="btn btn-outline-success"><i class="fas fa-file-excel me-2"></i> Exporter Excel</a>
        {% else %}
            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 fs-6 px-3 py-2 d-flex align-items-center">
                <i class="fas fa-pencil-alt me-2"></i> Brouillon
            </span>
        {% endif %}
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-9">
        <form method="post" id="invoiceForm">
            <div class="glass-card overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Ressource</th>
                                <th>Type</th>
                                <th class="text-center">Unité</th>
                                <th class="text-end">Prix Unit. (TND)</th>
                                <th class="text-center" style="width: 150px;">Consommation</th>
                                <th class="text-end">Total (TND)</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in invoice.invoiceLines %}
                                <tr>
                                    <td class="fw-semibold">{{ line.resourceName }}</td>
                                    <td>{{ line.serviceType|default('-') }}</td>
                                    <td class="text-center"><span class="badge bg-secondary">{{ line.unit }}</span></td>
                                    <td class="text-end font-monospace fw-semibold" style="color: #60a5fa;">{{ line.unitPrice|number_format(4, ',', ' ') }}</td>
                                    <td>
                                        <input type="number" step="0.0001" min="0" 
                                               name="quantities[{{ line.id }}]" 
                                               value="{{ line.consumedQuantity }}" 
                                               class="form-control form-control-sm text-center bg-dark text-light border-secondary quantity-input"
                                               data-price="{{ line.unitPrice }}"
                                               data-target="total-{{ line.id }}"
                                               {% if invoice.status == 'Validée' %}disabled{% endif %}>
                                    </td>
                                    <td class="text-end fw-bold text-accent font-monospace" id="total-{{ line.id }}">{{ line.lineTotal }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if invoice.status != 'Validée' %}
                <div class="d-flex justify-content-end mt-4 gap-3">
                    <button type="submit" name="save" class="btn btn-outline-primary px-4">
                        <i class="fas fa-save me-2"></i> Enregistrer le brouillon
                    </button>
                    <button type="submit" name="validate" value="1" class="btn btn-success px-4 shadow" onclick="return confirm('Êtes-vous sûr de vouloir valider cette facture ? Elle ne pourra plus être modifiée ensuite.');">
                        <i class="fas fa-check-double me-2"></i> Valider définitivement
                    </button>
                </div>
            {% endif %}
        </form>
    </div>

    <div class="col-lg-3">
        <div class="glass-card p-4 position-sticky" style="top: 2rem;">
            <h5 class="fw-semibold mb-4 text-center">Récapitulatif</h5>
            
            <div class="d-flex justify-content-between mb-2">
                <span style="color: rgba(180, 200, 230, 0.75);">Total HT</span>
                <span class="fw-medium font-monospace" id="summary-ht">{{ invoice.totalHT|number_format(4, ',', ' ') }}</span>
            </div>
            
            <div class="d-flex justify-content-between mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                <span style="color: rgba(180, 200, 230, 0.75);">TVA ({{ invoice.tvaRate }}%)</span>
                <span class="fw-medium font-monospace" id="summary-tva">{{ invoice.totalTVA|number_format(4, ',', ' ') }}</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-5 fw-bold">Total TTC</span>
                <span class="fs-4 fw-bold text-accent font-monospace" id="summary-ttc">{{ invoice.totalTTC }}</span>
            </div>
            <div class="text-end text-muted small mt-1">TND</div>
            
            {% if invoice.status == 'Validée' %}
                <div class="alert alert-success bg-success bg-opacity-10 text-success border-0 mt-4 small mb-0">
                    <i class="fas fa-info-circle me-1"></i> Facture figée le {{ invoice.validatedAt|date('d/m/Y à H:i') }} par {{ invoice.validatedBy.fullName }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputs = document.querySelectorAll('.quantity-input');
        const tvaRate = {{ invoice.tvaRate }};
        
        function updateTotals() {
            let totalHT = 0;
            
            inputs.forEach(input => {
                const price = parseFloat(input.dataset.price) || 0;
                const qty = parseFloat(input.value) || 0;
                const lineTotal = price * qty;
                
                // Update line total
                document.getElementById(input.dataset.target).textContent = lineTotal.toFixed(4);
                totalHT += lineTotal;
            });
            
            const totalTVA = totalHT * (tvaRate / 100);
            const totalTTC = totalHT + totalTVA;
            
            document.getElementById('summary-ht').textContent = totalHT.toFixed(4);
            document.getElementById('summary-tva').textContent = totalTVA.toFixed(4);
            document.getElementById('summary-ttc').textContent = totalTTC.toFixed(4);
        }

        inputs.forEach(input => {
            input.addEventListener('input', updateTotals);
        });
    });
</script>
{% endblock %}
