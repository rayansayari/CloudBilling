{% extends 'base_admin.html.twig' %}

{% block title %}Assistant IA — CloudBill Admin{% endblock %}
{% block page_title %}Assistant IA{% endblock %}
{% block breadcrumb %}
    <span class="sep">/</span> <span class="current">Chatbot IA</span>
{% endblock %}

{% block stylesheets %}
<style>
/* ========== CHATBOT UI ========== */
.chat-wrapper {
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--adm-topbar-h) - 32px - 2.5rem);
    min-height: 500px;
    max-height: 820px;
}

.chat-header {
    background: rgba(8, 16, 36, 0.95);
    border: 1px solid rgba(124, 58, 237, 0.25);
    border-radius: 14px 14px 0 0;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.chat-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-avatar {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 0 16px rgba(124, 58, 237, 0.5);
    animation: avatarPulse 3s ease-in-out infinite;
}

@keyframes avatarPulse {
    0%, 100% { box-shadow: 0 0 16px rgba(124, 58, 237, 0.4); }
    50%       { box-shadow: 0 0 28px rgba(124, 58, 237, 0.7); }
}

.chat-name { font-size: 0.9rem; font-weight: 700; color: #f0f4ff; }
.chat-status {
    font-size: 0.68rem; color: #10b981;
    display: flex; align-items: center; gap: 5px;
}

.chat-status::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #10b981;
    animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
}

/* Messages area */
.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    background: rgba(3, 7, 16, 0.8);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-top: none;
    border-bottom: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scroll-behavior: smooth;
}

.chat-messages::-webkit-scrollbar { width: 4px; }
.chat-messages::-webkit-scrollbar-track { background: transparent; }
.chat-messages::-webkit-scrollbar-thumb {
    background: rgba(124, 58, 237, 0.3);
    border-radius: 2px;
}

/* Message bubbles */
.msg {
    display: flex;
    gap: 10px;
    animation: msgIn 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
    max-width: 85%;
}

@keyframes msgIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
}

.msg.user { flex-direction: row-reverse; align-self: flex-end; }
.msg.bot  { flex-direction: row;         align-self: flex-start; }

.msg-icon {
    width: 30px; height: 30px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 2px;
}

.msg.bot  .msg-icon { background: linear-gradient(135deg, #7c3aed, #4f46e5); }
.msg.user .msg-icon {
    background: rgba(14, 165, 233, 0.15);
    border: 1px solid rgba(14, 165, 233, 0.3);
    color: #0ea5e9;
}

.msg-bubble {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.82rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
}

.msg.bot .msg-bubble {
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: #e2e8f0;
    border-top-left-radius: 3px;
}

.msg.user .msg-bubble {
    background: rgba(14, 165, 233, 0.15);
    border: 1px solid rgba(14, 165, 233, 0.25);
    color: #e2e8f0;
    border-top-right-radius: 3px;
}

.msg-time {
    font-size: 0.6rem;
    color: rgba(100, 116, 139, 0.6);
    margin-top: 4px;
    text-align: right;
}

.msg.bot .msg-time { text-align: left; }

/* Typing indicator */
.typing-indicator {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 1rem;
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 12px;
    border-top-left-radius: 3px;
    font-size: 0.75rem;
    color: rgba(124, 58, 237, 0.8);
    align-self: flex-start;
    max-width: 120px;
}

.typing-indicator.active { display: flex; }

.typing-dots { display: flex; gap: 4px; }
.typing-dots span {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #7c3aed;
    animation: typingDot 1.2s ease-in-out infinite;
}
.typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.typing-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingDot {
    0%, 100% { transform: scale(1); opacity: 0.4; }
    50%       { transform: scale(1.3); opacity: 1; }
}

/* Input area */
.chat-input-area {
    background: rgba(8, 16, 36, 0.95);
    border: 1px solid rgba(124, 58, 237, 0.25);
    border-radius: 0 0 14px 14px;
    padding: 1rem 1.25rem;
    flex-shrink: 0;
}

.chat-input-row {
    display: flex;
    gap: 10px;
    align-items: flex-end;
}

.chat-input {
    flex: 1;
    background: rgba(3, 7, 16, 0.8);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 10px;
    padding: 0.65rem 1rem;
    color: #e2e8f0;
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    outline: none;
    resize: none;
    min-height: 44px;
    max-height: 120px;
    transition: border-color 0.2s;
    line-height: 1.5;
}

.chat-input:focus { border-color: rgba(124, 58, 237, 0.6); }
.chat-input::placeholder { color: rgba(100, 116, 139, 0.5); }

.chat-send-btn {
    width: 44px; height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, #7c3aed, #6d28d9);
    border: none;
    color: #fff;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}

.chat-send-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.5);
}

.chat-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* Quick prompts */
.quick-prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 0.75rem;
}

.quick-prompt-btn {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: var(--adm-purple-l);
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Inter', sans-serif;
}

.quick-prompt-btn:hover {
    background: rgba(124, 58, 237, 0.25);
    color: #fff;
    transform: translateY(-1px);
}

/* Welcome message */
.welcome-box {
    text-align: center;
    padding: 2rem 1rem;
    color: rgba(100, 116, 139, 0.7);
}

.welcome-box .icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    display: block;
    filter: drop-shadow(0 0 12px rgba(124, 58, 237, 0.5));
}

.welcome-box h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: #e2e8f0;
    margin-bottom: 0.5rem;
}

.welcome-box p {
    font-size: 0.78rem;
    line-height: 1.6;
    max-width: 360px;
    margin: 0 auto;
}
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 style="font-size:1.1rem;font-weight:800;color:#e2e8f0;display:flex;align-items:center;gap:10px;">
            <img src="{{ asset('images/ns-logo.png') }}" alt="NextStep" style="height:24px;border-radius:4px;"> 
            NextStep AI Assistant
        </h1>
        <p style="font-size:0.72rem;color:var(--adm-muted);">Posez vos questions sur les données de votre système en temps réel.</p>
    </div>
    <button id="resetChat" class="adm-btn adm-btn-sm" style="border:1px solid rgba(100,116,139,0.2);color:var(--adm-muted);">
        <i class="fas fa-rotate-right"></i> Nouvelle conversation
    </button>
</div>

<div class="chat-wrapper">
    <!-- Header -->
    <div class="chat-header">
        <div class="chat-header-left">
            <div class="chat-avatar" style="background:transparent;box-shadow:none;animation:none;">
                <img src="{{ asset('images/ns-logo.png') }}" alt="AI" style="width:100%;height:100%;object-fit:cover;border-radius:10px;box-shadow:0 0 15px rgba(0,174,239,0.4);">
            </div>
            <div>
                <div class="chat-name" style="color:#00aeef;">NextStep AI</div>
                <div class="chat-status">En ligne — Connecté à la Base de données</div>
            </div>
        </div>
        <div style="font-size:0.68rem;color:var(--adm-muted);">
            <i class="fas fa-bolt text-warning me-1"></i> Propulsé par Gemini 3.5
        </div>
    </div>

    <!-- Messages -->
    <div class="chat-messages" id="chatMessages" style="position:relative;">
        
        <!-- Background Logo Watermark -->
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);opacity:0.03;pointer-events:none;">
            <img src="{{ asset('images/ns-logo.png') }}" alt="Watermark" style="width:300px;filter:grayscale(100%);">
        </div>

        <!-- Welcome -->
        <div class="welcome-box" id="welcomeBox" style="position:relative;z-index:1;">
            <img src="{{ asset('images/ns-logo.png') }}" alt="NS" style="width:60px;margin-bottom:1rem;border-radius:12px;box-shadow:0 0 20px rgba(0,174,239,0.3);">
            <h3 style="color:#00aeef;font-size:1.1rem;">Bonjour, Administrateur !</h3>
            <p>Je suis <strong>NextStep AI Assistant</strong>. Je connais toutes vos données : sociétés, projets, factures, utilisateurs. Posez-moi vos questions !</p>
        </div>

        <!-- Typing indicator -->
        <div class="typing-indicator" id="typingIndicator" style="position:relative;z-index:1;">
            <div class="typing-dots">
                <span style="background:#00aeef;"></span><span style="background:#00aeef;"></span><span style="background:#00aeef;"></span>
            </div>
            <span style="font-size:0.68rem;color:#00aeef;">...</span>
        </div>
    </div>

    <!-- Input Area -->
    <div class="chat-input-area">
        <!-- Quick prompts -->
        <div class="quick-prompts" id="quickPrompts">
            <button class="quick-prompt-btn" data-prompt="Combien de sociétés et projets actifs avons-nous ?">📊 Résumé global</button>
            <button class="quick-prompt-btn" data-prompt="Quel est le chiffre d'affaires total de cette année ?">💰 CA de l'année</button>
            <button class="quick-prompt-btn" data-prompt="Quels projets n'ont pas encore de factures validées ce mois ?">⚠️ Factures manquantes</button>
            <button class="quick-prompt-btn" data-prompt="Liste-moi les 5 projets avec le plus grand nombre de factures.">📋 Top projets</button>
            <button class="quick-prompt-btn" data-prompt="Quelles ont été les dernières actions dans le système ?">🔍 Activité récente</button>
        </div>

        <div class="chat-input-row">
            <textarea
                id="chatInput"
                class="chat-input"
                placeholder="Posez votre question sur les données..."
                rows="1"
            ></textarea>
            <button class="chat-send-btn" id="sendBtn" title="Envoyer (Entrée)">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const chatMessages = document.getElementById('chatMessages');
const chatInput    = document.getElementById('chatInput');
const sendBtn      = document.getElementById('sendBtn');
const typingIndicator = document.getElementById('typingIndicator');
const welcomeBox   = document.getElementById('welcomeBox');

// Auto-resize textarea
chatInput.addEventListener('input', function () {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
});

// Envoyer avec Entrée (Shift+Entrée = nouvelle ligne)
chatInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
});

sendBtn.addEventListener('click', sendMessage);

// Quick prompts
document.querySelectorAll('.quick-prompt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        chatInput.value = btn.dataset.prompt;
        chatInput.focus();
        sendMessage();
    });
});

// Reset
document.getElementById('resetChat').addEventListener('click', async () => {
    await fetch('{{ path('app_admin_chatbot_reset') }}', { method: 'POST' });
    // Vider les messages sauf le welcome et le typing
    const msgs = chatMessages.querySelectorAll('.msg');
    msgs.forEach(m => m.remove());
    welcomeBox.style.display = '';
    document.getElementById('quickPrompts').style.display = '';
});

function getTime() {
    return new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
}

function addMessage(text, role) {
    welcomeBox.style.display = 'none';
    document.getElementById('quickPrompts').style.display = 'none';

    const div = document.createElement('div');
    div.className = `msg ${role}`;

    const icon = role === 'bot'
        ? '<div class="msg-icon">🤖</div>'
        : '<div class="msg-icon"><i class="fas fa-user"></i></div>';

    div.innerHTML = `
        ${icon}
        <div>
            <div class="msg-bubble">${escapeHtml(text)}</div>
            <div class="msg-time">${getTime()}</div>
        </div>
    `;

    chatMessages.insertBefore(div, typingIndicator);
    scrollToBottom();
    return div;
}

function escapeHtml(text) {
    return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\n/g, '<br>');
}

function scrollToBottom() {
    chatMessages.scrollTop = chatMessages.scrollHeight;
}

function showTyping() {
    typingIndicator.classList.add('active');
    scrollToBottom();
}

function hideTyping() {
    typingIndicator.classList.remove('active');
}

async function sendMessage() {
    const text = chatInput.value.trim();
    if (!text) return;

    chatInput.value = '';
    chatInput.style.height = 'auto';
    sendBtn.disabled = true;

    addMessage(text, 'user');
    showTyping();

    try {
        const res = await fetch('{{ path('app_admin_chatbot_message') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text }),
        });

        const data = await res.json();
        hideTyping();

        if (data.reply) {
            addMessage(data.reply, 'bot');
        } else if (data.error) {
            addMessage('⚠️ ' + data.error, 'bot');
        }
    } catch (err) {
        hideTyping();
        addMessage('⚠️ Impossible de contacter le serveur.', 'bot');
    } finally {
        sendBtn.disabled = false;
        chatInput.focus();
        scrollToBottom();
    }
}
</script>
{% endblock %}
