{% extends 'base_admin.html.twig' %}

{% block title %}Nouvel Utilisateur — Admin{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block breadcrumb %}
    <span class="sep">/</span> <a href="{{ path('app_admin_user_index') }}">Utilisateurs</a>
    <span class="sep">/</span> <span class="current">Nouveau</span>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <div>
        <h1>Nouvel Utilisateur</h1>
    </div>
    <div>
        <a href="{{ path('app_admin_user_index') }}" class="adm-btn adm-btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="adm-card" style="max-width: 600px;">
    <div class="adm-card-header">
        <div class="adm-card-title"><i class="fas fa-user"></i> Informations</div>
    </div>
    <div class="adm-card-body">
        {{ form_start(form, {'attr': {'id': 'userForm'}}) }}
            <div class="mb-3">
                <label class="adm-form-label">Nom complet</label>
                {{ form_widget(form.fullName, {'attr': {'class': 'adm-form-control'}}) }}
                <div class="text-danger mt-1" style="font-size:0.7rem;">{{ form_errors(form.fullName) }}</div>
            </div>
            
            <div class="mb-3">
                <label class="adm-form-label">Email</label>
                {{ form_widget(form.email, {'attr': {'class': 'adm-form-control'}}) }}
            </div>
            
            <div class="mb-3">
                <label class="adm-form-label">Rôles</label>
                {{ form_widget(form.roles, {'attr': {'class': 'adm-form-select adm-form-control'}}) }}
            </div>
            
            <div class="mb-4">
                <label class="adm-form-label">Mot de passe</label>
                {{ form_widget(form.plainPassword, {'attr': {'class': 'adm-form-control'}}) }}
            </div>

            <!-- Reconnaissance Faciale -->
            <div class="mb-4">
                <label class="adm-form-label"><i class="fas fa-camera"></i> Reconnaissance Faciale (Optionnel)</label>
                <div class="face-enroll-container">
                    <input type="hidden" name="face_descriptor" id="faceDescriptorInput">
                    
                    <div id="faceStatus" class="face-status-badge text-muted">
                        <i class="fas fa-info-circle"></i> Aucun visage enregistré
                    </div>

                    <div id="webcamWrapper" style="display:none; position:relative; width:100%; max-width:320px; border-radius:12px; overflow:hidden; margin-top:10px; border:2px solid #0ea5e9;">
                        <video id="video" autoplay muted playsinline style="width:100%; display:block; transform: scaleX(-1);"></video>
                        <canvas id="overlay" style="position:absolute; top:0; left:0; width:100%; height:100%; transform: scaleX(-1);"></canvas>
                        <div id="scanLine" style="position:absolute; top:0; left:0; width:100%; height:2px; background:#0ea5e9; box-shadow:0 0 10px #0ea5e9; display:none; animation: scanDown 2s linear infinite;"></div>
                    </div>

                    <button type="button" id="startCamBtn" class="adm-btn adm-btn-outline-primary mt-2 btn-sm">
                        <i class="fas fa-video"></i> Activer la caméra
                    </button>
                    <button type="button" id="captureBtn" class="adm-btn adm-btn-primary mt-2 btn-sm" style="display:none;">
                        <i class="fas fa-expand"></i> Scanner & Enregistrer le visage
                    </button>
                </div>
            </div>
            
            <button class="adm-btn adm-btn-primary w-100 justify-content-center py-2" style="font-size:0.85rem;" id="submitBtn">
                <i class="fas fa-save"></i> Enregistrer l'utilisateur
            </button>
        {{ form_end(form) }}
    </div>
</div>

<style>
@keyframes scanDown {
    0% { top: 0; }
    100% { top: 100%; }
}
.face-enroll-container {
    background: rgba(14, 165, 233, 0.05);
    border: 1px dashed rgba(14, 165, 233, 0.3);
    padding: 1rem;
    border-radius: 8px;
}
.face-status-badge {
    font-size: 0.8rem;
    font-weight: 600;
}
.face-status-badge.success { color: #10b981 !important; }
.face-status-badge.error { color: #ef4444 !important; }
</style>

<script defer src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const MODEL_URL = 'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights';
    const video = document.getElementById('video');
    const overlay = document.getElementById('overlay');
    const startCamBtn = document.getElementById('startCamBtn');
    const captureBtn = document.getElementById('captureBtn');
    const webcamWrapper = document.getElementById('webcamWrapper');
    const faceStatus = document.getElementById('faceStatus');
    const faceDescriptorInput = document.getElementById('faceDescriptorInput');
    const scanLine = document.getElementById('scanLine');
    let stream = null;
    let modelsLoaded = false;
    let detectionInterval;

    async function loadModels() {
        faceStatus.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Chargement des modèles IA...';
        await Promise.all([
            faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
            faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
            faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
        ]);
        modelsLoaded = true;
        faceStatus.innerHTML = '<i class="fas fa-camera"></i> Modèles chargés. Prêt à activer la caméra.';
        startCamBtn.disabled = false;
    }

    startCamBtn.addEventListener('click', async () => {
        if (!modelsLoaded) return;
        try {
            stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
            video.srcObject = stream;
            webcamWrapper.style.display = 'block';
            startCamBtn.style.display = 'none';
            captureBtn.style.display = 'inline-block';
            
            video.onloadeddata = () => {
                faceStatus.innerHTML = '<i class="fas fa-user-check"></i> Positionnez le visage dans le cadre...';
                startDetectionLoop();
            };
        } catch (err) {
            faceStatus.className = 'face-status-badge error';
            faceStatus.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Erreur caméra: ' + err.message;
        }
    });

    function startDetectionLoop() {
        const ctx = overlay.getContext('2d');
        detectionInterval = setInterval(async () => {
            if (video.paused || video.ended) return;
            overlay.width = video.videoWidth;
            overlay.height = video.videoHeight;
            const detections = await faceapi.detectAllFaces(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks();
            ctx.clearRect(0, 0, overlay.width, overlay.height);
            faceapi.draw.drawDetections(overlay, detections);
            faceapi.draw.drawFaceLandmarks(overlay, detections);
        }, 100);
    }

    captureBtn.addEventListener('click', async () => {
        captureBtn.disabled = true;
        scanLine.style.display = 'block';
        faceStatus.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyse en cours...';

        try {
            const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptor();
            
            if (detection) {
                const descriptor = Array.from(detection.descriptor);
                faceDescriptorInput.value = JSON.stringify(descriptor);
                
                faceStatus.className = 'face-status-badge success';
                faceStatus.innerHTML = '<i class="fas fa-check-circle"></i> Visage capturé et prêt à être enregistré !';
                
                // Stop camera
                clearInterval(detectionInterval);
                stream.getTracks().forEach(track => track.stop());
                setTimeout(() => { webcamWrapper.style.display = 'none'; }, 1000);
                captureBtn.style.display = 'none';
            } else {
                faceStatus.className = 'face-status-badge error';
                faceStatus.innerHTML = '<i class="fas fa-times-circle"></i> Aucun visage détecté. Réessayez.';
                captureBtn.disabled = false;
            }
        } catch (err) {
            faceStatus.className = 'face-status-badge error';
            faceStatus.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Erreur: ' + err.message;
            captureBtn.disabled = false;
        } finally {
            scanLine.style.display = 'none';
        }
    });

    // Load models on page load
    startCamBtn.disabled = true;
    setTimeout(loadModels, 500);
});
</script>
{% endblock %}
