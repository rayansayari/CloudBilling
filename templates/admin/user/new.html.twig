{% extends 'base.html.twig' %}

{% block title %}Nouvel Utilisateur - CloudBill{% endblock %}
{% block page_title %}Créer un Utilisateur{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-primary bg-opacity-25 p-3 rounded-3 me-3 text-primary">
                    <i class="fas fa-user-plus fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-1 text-white">Nouveau collaborateur</h5>
                    <p class="text-muted mb-0 small">Créez un compte pour permettre l'accès à CloudBill</p>
                </div>
            </div>

            {{ include('admin/user/_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
