{{ form_start(form) }}
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.fullName) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.email) }}
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.plainPassword) }}
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label mb-2">Rôles attribués</label>
        <div class="glass-card p-3 border border-secondary border-opacity-50">
            {{ form_widget(form.roles) }}
            {{ form_errors(form.roles) }}
        </div>
        <small class="text-muted d-block mt-2">
            <i class="fas fa-info-circle me-1"></i> Les administrateurs ont un accès complet à l'application.
        </small>
    </div>
</div>

<div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-end">
    <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary me-2">Annuler</a>
    <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
</div>
{{ form_end(form) }}
