{% extends 'base_admin.html.twig' %}

{% block title %}Modifier Utilisateur — Admin{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block breadcrumb %}
    <span class="sep">/</span> <a href="{{ path('app_admin_user_index') }}">Utilisateurs</a>
    <span class="sep">/</span> <span class="current">Modifier</span>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <div>
        <h1>Modifier : {{ user.fullName }}</h1>
    </div>
    <div>
        <a href="{{ path('app_admin_user_index') }}" class="adm-btn adm-btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="adm-card" style="max-width: 600px;">
    <div class="adm-card-header">
        <div class="adm-card-title"><i class="fas fa-user-edit"></i> Informations</div>
    </div>
    <div class="adm-card-body">
        {{ form_start(form) }}
            <div class="mb-3">
                <label class="adm-form-label">Nom complet</label>
                {{ form_widget(form.fullName, {'attr': {'class': 'adm-form-control'}}) }}
                <div class="text-danger mt-1" style="font-size:0.7rem;">{{ form_errors(form.fullName) }}</div>
            </div>
            
            <div class="mb-3">
                <label class="adm-form-label">Email</label>
                {{ form_widget(form.email, {'attr': {'class': 'adm-form-control'}}) }}
            </div>
            
            <div class="mb-3">
                <label class="adm-form-label">Rôles</label>
                {{ form_widget(form.roles, {'attr': {'class': 'adm-form-select adm-form-control'}}) }}
            </div>
            
            <div class="mb-4">
                <label class="adm-form-label">Nouveau Mot de passe (laisser vide pour ne pas changer)</label>
                {{ form_widget(form.plainPassword, {'attr': {'class': 'adm-form-control'}}) }}
            </div>
            
            <button class="adm-btn adm-btn-primary w-100 justify-content-center py-2" style="font-size:0.85rem;">
                <i class="fas fa-save"></i> Mettre à jour
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
