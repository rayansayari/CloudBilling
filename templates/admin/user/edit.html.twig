{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur - CloudBill{% endblock %}
{% block page_title %}Modifier un Utilisateur{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-info bg-opacity-25 p-3 rounded-3 me-3 text-info">
                    <i class="fas fa-user-edit fs-4"></i>
                </div>
                <div>
                    <h5 class="mb-1 text-white">{{ user.fullName }}</h5>
                    <p class="text-muted mb-0 small">{{ user.email }}</p>
                </div>
            </div>

            {{ include('admin/user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
</div>
{% endblock %}
