{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Utilisateurs — Admin{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block breadcrumb %}
    <span class="sep">/</span> <span class="current">Utilisateurs</span>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <div>
        <h1>Base de données Utilisateurs</h1>
        <p>Gérez les accès administrateurs et consultants.</p>
    </div>
    <div>
        <a href="{{ path('app_admin_user_new') }}" class="adm-btn adm-btn-primary">
            <i class="fas fa-user-plus"></i> Nouvel Utilisateur
        </a>
    </div>
</div>

<div class="adm-card">
    <div class="p-0">
        <table class="adm-table">
            <thead>
                <tr>
                    <th>Utilisateur</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Créé le</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in pagination %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="https://ui-avatars.com/api/?name={{ user.fullName|url_encode }}&background=1e293b&color=0ea5e9" width="30" height="30" class="rounded-circle" alt="">
                                <span class="fw-bold">{{ user.fullName }}</span>
                            </div>
                        </td>
                        <td class="text-muted">{{ user.email }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="adm-badge purple">Admin</span>
                            {% else %}
                                <span class="adm-badge cyan">Consultant</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ user.createdAt|date('d/m/Y') }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="adm-btn adm-btn-icon adm-btn-primary" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" class="d-inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button class="adm-btn adm-btn-icon adm-btn-danger border-0" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="adm-pagination">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
