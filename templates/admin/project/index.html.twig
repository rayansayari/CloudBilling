{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Projets — Admin{% endblock %}
{% block page_title %}Projets (SO){% endblock %}
{% block breadcrumb %}
    <span class="sep">/</span> <span class="current">Projets</span>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <div>
        <h1>Base de données Projets (SO)</h1>
        <p>Gérez les projets liés aux sociétés clientes.</p>
    </div>
</div>

<div class="adm-card">
    <div class="p-0">
        <table class="adm-table">
            <thead>
                <tr>
                    <th>Numéro SO</th>
                    <th>Nom du Projet</th>
                    <th>Société Cliente</th>
                    <th>Statut</th>
                    <th>Début</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for project in pagination %}
                    <tr>
                        <td class="fw-bold" style="color:var(--adm-cyan);">{{ project.soNumber }}</td>
                        <td>{{ project.name }}</td>
                        <td><span class="adm-badge purple">{{ project.company.name }}</span></td>
                        <td>
                            {% if project.status == 'Actif' %}
                                <span class="adm-badge green">Actif</span>
                            {% elseif project.status == 'En pause' %}
                                <span class="adm-badge orange">En pause</span>
                            {% else %}
                                <span class="adm-badge gray">{{ project.status }}</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ project.startDate|date('d/m/Y') }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_project_edit', {'id': project.id}) }}" class="adm-btn adm-btn-icon adm-btn-primary" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_admin_project_delete', {'id': project.id}) }}" class="d-inline-block" onsubmit="return confirm('Attention ! Supprimer ce projet supprimera toutes ses offres et factures. Confirmer ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                <button class="adm-btn adm-btn-icon adm-btn-danger border-0" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Aucun projet trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="adm-pagination">
    {{ knp_pagination_render(pagination) }}
</div>
{% endblock %}
